/* Service worker : consultation hors ligne des pages essentielles (mode manif).
   Version liée au build : chaque déploiement remplace le cache. */
const VERSION = "mob-{{ site.buildTime | replace(':', '') | replace('.', '') }}";
const CORE = [
  "./",
  "mode-manif/",
  "agenda/",
  "droits/",
  "faq/",
  "agir/",
  "assets/css/style.css",
  "assets/js/main.js",
  "assets/fonts/archivo-var.woff2",
  "assets/fonts/atkinson-next-var.woff2",
  "assets/fonts/plex-mono-500.woff2",
  "assets/img/favicon.svg",
  "manifest.webmanifest",
  "agenda.ics"
];

self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(VERSION).then((cache) => cache.addAll(CORE.map((p) => new URL(p, self.registration.scope).href))).then(() => self.skipWaiting())
  );
});

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches.keys().then((keys) => Promise.all(keys.filter((k) => k.startsWith("mob-") && k !== VERSION).map((k) => caches.delete(k)))).then(() => self.clients.claim())
  );
});

self.addEventListener("fetch", (event) => {
  const req = event.request;
  if (req.method !== "GET" || new URL(req.url).origin !== self.location.origin) return;
  const isPage = req.mode === "navigate" || (req.headers.get("accept") || "").includes("text/html");
  if (isPage) {
    // Réseau d'abord (contenu frais), cache ensuite, et le mode manif en dernier recours.
    event.respondWith(
      fetch(req)
        .then((res) => {
          const copy = res.clone();
          caches.open(VERSION).then((c) => c.put(req, copy));
          return res;
        })
        .catch(() =>
          caches.match(req, { ignoreSearch: true }).then((hit) => hit || caches.match(new URL("mode-manif/", self.registration.scope).href))
        )
    );
    return;
  }
  // Ressources statiques : cache d'abord, mise à jour en arrière-plan.
  event.respondWith(
    caches.match(req).then((hit) => {
      const net = fetch(req)
        .then((res) => {
          if (res.ok) {
            const copy = res.clone();
            caches.open(VERSION).then((c) => c.put(req, copy));
          }
          return res;
        })
        .catch(() => hit);
      return hit || net;
    })
  );
});
