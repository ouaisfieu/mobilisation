{#- Attend une variable `ev` (élément de events.json) #}
<article class="event{% if ev.featured %} event--featured{% endif %}" id="{{ ev.id }}" data-event data-date="{{ ev.date }}" data-region="{{ ev.region }}" data-sector="{{ ev.sector }}">
  <div class="event__date" aria-hidden="true">
    <span class="event__wd">{{ ev.date | weekday }}</span>
    <span class="event__d">{{ ev.date | dayNum }}</span>
    <span class="event__m">{{ ev.date | monthShort }}</span>
  </div>
  <div class="event__body">
    <p class="event__meta"><span class="badge{% if ev.featured %} badge--accent{% endif %}">{{ ev.kind }}</span> <span class="event__status" data-relative="{{ ev.date }}">{{ ev.status }}</span></p>
    <h3 class="event__title">{{ ev.title }}</h3>
    <p class="event__when"><span class="sr-only">Date : </span>{{ ev.date | dateLong }}</p>
    <ul class="event__facts">
      <li>{% icon "pin" %} {{ ev.place }}<span class="event__region"> · {{ ev.region }}</span></li>
      <li>{% icon "users" %} {{ ev.organizers }}</li>
    </ul>
    <p class="event__summary">{{ ev.summary }}</p>
    {%- if ev.practical %}<p class="event__practical">{% icon "info" %} {{ ev.practical }}</p>{% endif %}
    <div class="event__actions">
      <a class="btn btn--small" href="/agenda/{{ ev.id }}.ics" download>{% icon "calendar" %} Ajouter à mon agenda</a>
      {%- if ev.sources.length %}<span class="event__src">{% srcs ev.sources | join(",") %}</span>{% endif %}
    </div>
  </div>
</article>
